
@model IEnumerable<Grad_Project_ITI_5.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">

        <div class="col-md-3">
            <input type="text"
                   id="searchInput"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control form-control-sm"
                   placeholder="Search name " />
        </div>

        <div class="col-md-3">
            <select name="departmentId"
                    asp-items="ViewBag.Departments"
                    class="form-select form-select-sm">
                <option value="">All Departments</option>
            </select>
        </div>

        <div class="col-md-3">
            <input type="date"
                   name="date"
                   value="@ViewBag.Date"
                   class="form-control form-control-sm" />
        </div>

        <div class="col-md-3 d-flex gap-1">
            <button type="submit"
                    class="btn btn-primary btn-sm">
                Filter
            </button>

            <a asp-action="Index"
               class="btn btn-secondary btn-sm">
                Clear
            </a>
        </div>

    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Student</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Enrollment Date</th>
            <th>Profile Image</th>
            <th>Department Name</th>
            <th>Enrolled Courses</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.EnrollmentDate.ToShortDateString()</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.ProfileImage))
                    {
                        <img src="@item.ProfileImage"
                             alt="Student Image"
                             width="70"
                             height="70"
                             style="object-fit: cover;" />
                    }
                    else
                    {
                        <span>No image</span>
                    }
                </td>


                <td>@item.Department?.Name</td>
                <td>
                    @if (item.StudentCourses != null && item.StudentCourses.Any())
                    {
                        @string.Join(", ",
                            item.StudentCourses
                                .Where(sc => sc.Course != null)
                                .Select(sc => sc.Course.Title))
                    }
                    else
                    {
                        <span>No courses</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.StudentId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.StudentId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.StudentId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

